[sqlfluff]
dialect = duckdb
templater = dbt
max_line_length = 120
# layout rules are noisy on aligned aliases; keep them as warnings in your editor
exclude_rules = LT01, LT02, LT05, LT09, LT14, AM03, AM04, ST06, ST07, CV03, RF04

[sqlfluff:templater:dbt]
project_dir = .
profiles_dir = .

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower
